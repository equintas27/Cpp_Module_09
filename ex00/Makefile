CXX = c++

CXXFLAGS = -Wall -Wextra -Werror -std=c++98

HEADER = BitcoinExchange.hpp 

OBJS = BitcoinExchange.o \
	   main.o

NAME = btc

all: $(NAME)

$(OBJS): $(HEADER)

$(NAME): $(OBJS)
	$(CXX) $(CXXFLAGS) $(OBJS) -o $(NAME)

clean: 
	rm -f $(OBJS)

fclean: clean
	rm -f $(NAME)

re: fclean all

.PHONY: all clean fclean re
